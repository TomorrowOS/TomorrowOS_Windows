<Window x:Class="TomorrowOS.Setup.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TomorrowOS Setup"
        Width="420"
        Height="168"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="TomorrowOS Windows"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="#141311"/>
    <TextBlock x:Name="StatusText"
               Grid.Row="1"
               Margin="0,10,0,0"
               FontSize="13"
               Foreground="#5d554d"
               Text="Preparing…"/>
    <ProgressBar x:Name="Bar"
                 Grid.Row="2"
                 Height="8"
                 Margin="0,16,0,0"
                 Minimum="0"
                 Maximum="100"
                 Value="0"
                 Foreground="#141311"
                 Background="#e6e6e6"
                 BorderThickness="0"/>
  </Grid>
</Window>
