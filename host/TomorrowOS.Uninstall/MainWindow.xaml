<Window x:Class="TomorrowOS.Uninstall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall TomorrowOS Windows"
        Width="460"
        Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI">
  <Grid Margin="28,24">
    <Grid x:Name="ConfirmPane">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Uninstall TomorrowOS Windows?"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#141311"/>
      <TextBlock Grid.Row="1"
                 Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 FontSize="13.5"
                 Foreground="#5d554d"
                 Text="This removes the player, watchdog, local cache, and startup registration from this computer. This cannot be undone."/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Cancel" Width="96" Height="36" Margin="0,0,8,0" Click="Cancel_Click"/>
        <Button Content="Uninstall" Width="110" Height="36" Click="Confirm_Click"
                Background="#141311" Foreground="#f8f3ea" BorderThickness="0" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="ProgressPane" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Uninstalling TomorrowOS Windows"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#141311"/>
      <TextBlock x:Name="StatusText"
                 Grid.Row="1"
                 Margin="0,12,0,0"
                 FontSize="13.5"
                 Foreground="#5d554d"
                 Text="Preparing…"/>
      <ProgressBar x:Name="Bar"
                   Grid.Row="2"
                   Height="8"
                   Margin="0,18,0,0"
                   Minimum="0"
                   Maximum="100"
                   Value="0"
                   Foreground="#141311"
                   Background="#e6e6e6"
                   BorderThickness="0"/>
    </Grid>

    <Grid x:Name="DonePane" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Uninstall successful"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#2f6b4f"/>
      <TextBlock Grid.Row="1"
                 Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 FontSize="13.5"
                 Foreground="#5d554d"
                 Text="TomorrowOS Windows has been removed from this computer."/>
      <Button Grid.Row="2"
              Content="Close"
              Width="110"
              Height="36"
              HorizontalAlignment="Right"
              Click="Close_Click"
              Background="#141311"
              Foreground="#f8f3ea"
              BorderThickness="0"
              FontWeight="SemiBold"/>
    </Grid>
  </Grid>
</Window>
